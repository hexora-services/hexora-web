rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function self(uid) { return request.auth != null && request.auth.uid == uid; }
  function workerExists(uid) { return exists(/databases/$(database)/documents/workerProfiles/$(uid)); }
  function approvedWorker(uid) { return workerExists(uid) && get(/databases/$(database)/documents/workerProfiles/$(uid)).data.approved == true; }
  function nameOK(v) { return v is string && v.size() >= 2 && v.size() <= 60; }
  function cityOK(v) { return v is string && v.size() >= 2 && v.size() <= 70; }
  function subOK(v) { return v is string && v.size() >= 2 && v.size() <= 90; }
  function feeOK(v) { return v is int && v >= 1 && v <= 2000; }
  function validWorker(d) {
    return d.keys().hasAll(['displayName','city','category','subcategory','visitFee','online','approved','updatedAt'])
     && d.keys().hasOnly(['displayName','city','category','subcategory','visitFee','online','approved','updatedAt','bio','experienceYears','photoURL','gallery'])
     && nameOK(d.displayName) && cityOK(d.city) && subOK(d.subcategory)
     && d.category is int && d.category >= 0 && d.category < 24
     && feeOK(d.visitFee) && d.online is bool && d.approved is bool
     && (!('bio' in d) || (d.bio is string && d.bio.size() <= 800))
     && (!('experienceYears' in d) || (d.experienceYears is int && d.experienceYears >= 0 && d.experienceYears <= 70))
     && (!('photoURL' in d) || (d.photoURL is string && d.photoURL.size() <= 1200))
     && (!('gallery' in d) || (d.gallery is list && d.gallery.size() <= 5));
  }
  function validContact(d) {
    return d.keys().hasAll(['phone','updatedAt'])
     && d.keys().hasOnly(['phone','updatedAt'])
     && d.phone is string && d.phone.size() <= 16
     && (d.phone == '' || d.phone.matches('^([+])?[0-9]{9,15}$'))
     && d.updatedAt == request.time;
  }
  match /accounts/{uid} {
    allow get: if self(uid);
    allow list: if false;
    allow create: if self(uid)
     && request.resource.data.keys().hasAll(['displayName','role','createdAt'])
     && request.resource.data.keys().hasOnly(['displayName','role','createdAt'])
     && nameOK(request.resource.data.displayName)
     && request.resource.data.role in ['customer','worker']
     && request.resource.data.createdAt == request.time;
    allow update, delete: if false;
  }
  match /workerProfiles/{uid} {
    allow get: if self(uid) || resource.data.approved == true;
    allow list: if resource.data.approved == true;
    allow create: if self(uid)
     && exists(/databases/$(database)/documents/accounts/$(uid))
     && get(/databases/$(database)/documents/accounts/$(uid)).data.role == 'worker'
     && validWorker(request.resource.data)
     && request.resource.data.approved == false
     && request.resource.data.online == false
     && request.resource.data.updatedAt == request.time;
    allow update: if self(uid)
     && validWorker(request.resource.data)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
       ['displayName','city','category','subcategory','visitFee','online','updatedAt','bio','experienceYears','photoURL','gallery'])
     && request.resource.data.approved == resource.data.approved
     && request.resource.data.updatedAt == request.time;
    allow delete: if false;
  }
  match /workerContacts/{uid} {
    allow get: if self(uid) || (request.auth != null && approvedWorker(uid));
    allow list: if false;
    allow create, update: if self(uid)
      && workerExists(uid) && validContact(request.resource.data);
    allow delete: if false;
  }
  match /workerInteractions/{workerUid}/{kind}/{viewerUid} {
    allow get: if self(workerUid) || self(viewerUid);
    allow list: if self(workerUid) && kind in ['views', 'clicks'];
    allow create: if self(viewerUid) && viewerUid != workerUid
      && kind in ['views','clicks'] && approvedWorker(workerUid)
      && request.resource.data.keys().hasAll(['viewerUid','createdAt'])
      && request.resource.data.keys().hasOnly(['viewerUid','createdAt'])
      && request.resource.data.viewerUid == viewerUid
      && request.resource.data.createdAt == request.time;
    allow update, delete: if false;
  }
  // One small public profile photo stored as a compressed JPEG data URL.
  // Temporary beta solution: Firestore is not a general-purpose image host.
  function validWorkerImage(d) {
    return d.keys().hasAll(['dataUrl','updatedAt'])
      && d.keys().hasOnly(['dataUrl','updatedAt'])
      && d.dataUrl is string
      && d.dataUrl.size() <= 105000
      && d.dataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$')
      && d.updatedAt == request.time;
  }
  match /workerImages/{uid} {
    allow get: if self(uid) || approvedWorker(uid);
    allow list: if false;
    allow create, update: if self(uid) && workerExists(uid)
      && validWorkerImage(request.resource.data);
    allow delete: if self(uid) && workerExists(uid);
  }
  // Public reviews for approved workers. One verified customer = one review per worker.
  // Ratings are user-submitted and do not assert a verified booking.
  function validReview(d) {
    return d.keys().hasAll(['rating','comment','createdAt','updatedAt'])
      && d.keys().hasOnly(['rating','comment','createdAt','updatedAt'])
      && d.rating is int && d.rating >= 1 && d.rating <= 5
      && d.comment is string && d.comment.size() <= 300;
  }
  function customerReviewer(reviewerUid,workerUid) {
    return self(reviewerUid)
      && reviewerUid != workerUid
      && request.auth.token.email_verified == true
      && exists(/databases/$(database)/documents/accounts/$(reviewerUid))
      && get(/databases/$(database)/documents/accounts/$(reviewerUid)).data.role == 'customer'
      && approvedWorker(workerUid);
  }
  match /workerReviews/{workerUid}/items/{reviewerUid} {
    allow get, list: if approvedWorker(workerUid);
    allow create: if customerReviewer(reviewerUid,workerUid)
      && validReview(request.resource.data)
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;
    allow update: if customerReviewer(reviewerUid,workerUid)
      && validReview(request.resource.data)
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.updatedAt == request.time
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','comment','updatedAt']);
    allow delete: if customerReviewer(reviewerUid,workerUid);
  }
  match /{path=**} { allow read, write: if false; }
 }
}
